# Production Environment Template for Amazon EC2 Deployment (HTC Core)

# Django Core Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-production-secret-key-here
ALLOWED_HOSTS=yourdomain.net,ec2-xxx-xxx-xxx-xxx.compute-1.amazonaws.com,localhost,127.0.0.1,nginx

# Database Configuration (PostgreSQL Docker container)
POSTGRES_DB=htc_core
POSTGRES_USER=htc_prod_user
POSTGRES_PASSWORD=set-a-strong-database-password-here
DATABASE_URL=postgres://htc_prod_user:set-a-strong-database-password-here@db:5432/htc_core

# Celery & Redis Task Broker
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# Security Settings
SECURE_SSL_REDIRECT=False
